{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2026-09-16T00:00:00.000Z",
  "__export_source": "auth-server-repo",
  "resources": [
    {
      "_id": "wrk_auth_server",
      "_type": "workspace",
      "parentId": null,
      "name": "auth-server",
      "description": "OAuth 2.0 Authorization Server with MFA"
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_auth_server",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:8080"
      }
    },
    {
      "_id": "fld_auth",
      "_type": "request_group",
      "parentId": "wrk_auth_server",
      "name": "Auth"
    },
    {
      "_id": "req_register",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Register",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/register",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_verify",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Verify Email",
      "method": "GET",
      "url": "{{ _.base_url }}/auth/verify",
      "parameters": [{ "name": "token", "value": "" }]
    },
    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_change_password",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Change Password",
      "method": "PUT",
      "url": "{{ _.base_url }}/auth/password",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"user@example.com\",\n  \"currentPassword\": \"StrongPassword123!\",\n  \"newPassword\": \"EvenStrongerPassword456!\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_password_reset_request",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Password Reset Request",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/password-reset-request",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"user@example.com\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_password_reset",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Password Reset",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/password-reset",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"token\": \"\",\n  \"newPassword\": \"EvenStrongerPassword456!\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_me_get",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Get Current User",
      "method": "GET",
      "url": "{{ _.base_url }}/auth/me",
      "authentication": {
        "type": "basic",
        "username": "user@example.com",
        "password": "StrongPassword123!"
      }
    },
    {
      "_id": "req_me_put",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Update Email",
      "method": "PUT",
      "url": "{{ _.base_url }}/auth/me",
      "authentication": {
        "type": "basic",
        "username": "user@example.com",
        "password": "StrongPassword123!"
      },
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"currentPassword\": \"StrongPassword123!\",\n  \"newEmail\": \"new-user@example.com\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "fld_oauth",
      "_type": "request_group",
      "parentId": "wrk_auth_server",
      "name": "OAuth2"
    },
    {
      "_id": "req_register_client",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "Register Client (admin only)",
      "method": "POST",
      "url": "{{ _.base_url }}/api/clients",
      "authentication": {
        "type": "basic",
        "username": "admin@example.com",
        "password": "StrongPassword123!"
      },
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"clientId\": \"demo-client\",\n  \"clientName\": \"Demo Client\",\n  \"redirectUris\": [\"http://localhost:8081/callback\"],\n  \"scopes\": [\"openid\", \"profile\"]\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }]
    },
    {
      "_id": "req_oauth_authorize",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "Authorize (Authorization Code + PKCE)",
      "method": "GET",
      "url": "{{ _.base_url }}/oauth2/authorize",
      "authentication": {
        "type": "basic",
        "username": "user@example.com",
        "password": "StrongPassword123!"
      },
      "parameters": [
        { "name": "response_type", "value": "code" },
        { "name": "client_id", "value": "demo-client" },
        { "name": "redirect_uri", "value": "http://localhost:8081/callback" },
        { "name": "scope", "value": "openid profile" },
        { "name": "code_challenge", "value": "" },
        { "name": "code_challenge_method", "value": "S256" },
        { "name": "state", "value": "xyz" }
      ]
    },
    {
      "_id": "req_oauth_token",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "Token (exchange authorization code)",
      "method": "POST",
      "url": "{{ _.base_url }}/oauth2/token",
      "authentication": {
        "type": "basic",
        "username": "demo-client",
        "password": ""
      },
      "body": {
        "mimeType": "application/x-www-form-urlencoded",
        "params": [
          { "name": "grant_type", "value": "authorization_code" },
          { "name": "code", "value": "" },
          { "name": "redirect_uri", "value": "http://localhost:8081/callback" },
          { "name": "code_verifier", "value": "" }
        ]
      }
    },
    {
      "_id": "req_oauth_revoke",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "Revoke Token",
      "method": "POST",
      "url": "{{ _.base_url }}/oauth2/revoke",
      "authentication": {
        "type": "basic",
        "username": "demo-client",
        "password": ""
      },
      "body": {
        "mimeType": "application/x-www-form-urlencoded",
        "params": [{ "name": "token", "value": "" }]
      }
    },
    {
      "_id": "req_oauth_introspect",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "Introspect Token",
      "method": "POST",
      "url": "{{ _.base_url }}/oauth2/introspect",
      "authentication": {
        "type": "basic",
        "username": "demo-client",
        "password": ""
      },
      "body": {
        "mimeType": "application/x-www-form-urlencoded",
        "params": [{ "name": "token", "value": "" }]
      }
    },
    {
      "_id": "req_oauth_jwks",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "JWK Set",
      "method": "GET",
      "url": "{{ _.base_url }}/oauth2/jwks"
    },
    {
      "_id": "req_oidc_discovery",
      "_type": "request",
      "parentId": "fld_oauth",
      "name": "OIDC Discovery",
      "method": "GET",
      "url": "{{ _.base_url }}/.well-known/openid-configuration"
    }
  ]
}
